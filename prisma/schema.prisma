generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  // Do NOT set `output` — @opennextjs/cloudflare patches the default client location.
}

datasource db {
  // Cloudflare D1 is SQLite-compatible.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Application user — identity, usage counters and subscription status in one
/// table (by design, keep the table count low). Anonymous visitors get a row
/// keyed by a cookie id; email/stripe columns stay NULL until a real account /
/// checkout exists (see migration 0002).
model User {
  id                 String    @id @default(cuid())
  /// Cookie id for anonymous visitors (set by middleware). Unique; a future
  /// OAuth login attaches itself to this row instead of creating a new one.
  anonId             String?   @unique
  email              String?   @unique
  name               String?
  image              String?
  /// Usage: incremented by /api/leads/search on every recorded search.
  searchCount        Int       @default(0)
  scoredCount        Int       @default(0)
  lastSearchAt       DateTime?
  /// "free" | "pro". Stripe columns stay NULL until the first checkout; the
  /// webhook keeps them in sync once billing exists.
  subscriptionPlan   String    @default("free")
  subscriptionStatus String?
  currentPeriodEnd   DateTime?
  stripeCustomerId   String?   @unique
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  runs               SearchRun[]

  @@map("x_lead_miner_user")
}

/// One executed search (query + result posts as JSON) — the row behind the
/// history page. Kept as JSON on purpose: the product stays at two tables and
/// a run is only ever read whole.
model SearchRun {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  query      String
  searchType String   @default("Latest")
  postCount  Int      @default(0)
  /// JSON array: [{ id, handle, name, text, score, sec, url, createdAtIso }]
  results    String
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, query])

  @@map("x_lead_miner_search")
}
