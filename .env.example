# Auth.js — generate secret with: openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true

# GitHub OAuth — create at https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth — create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe — from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Webhook signing secret — from Stripe webhook endpoint details
STRIPE_WEBHOOK_SECRET=
# Pro plan price ID (price_xxx) — from Stripe product dashboard
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=

# AI API Key X data (https://aiapikey.ai) — server-only, sent as an
# `Authorization: Bearer` header. Verified contract: docs/x-api.md
AIAPIKEY_KEY=

# MuleRun LLM gateway (https://api.mulerun.com) — powers /api/chat and the
# intent-model labeling teacher (intent/label.py). OpenAI-compatible.
MULERUN_API_KEY=
MULERUN_LLM_MODEL=gemini-2.5-flash

# Local PyTorch intent sidecar (intent/serve.py). Unset ⇒ search results
# simply carry no scores.
# INTENT_SERVICE_URL=http://127.0.0.1:5019

# Lead Analyst — the SECOND model (Qwen3-4B + LoRA, served on Modal). Optional:
# unset ⇒ the site offers no lead cards and everything else works as before.
# Details: docs/lead-analyst.md. Token: `modal workspace proxy-tokens create`.
# ANALYST_URL=https://zhangwenzhu998--xlead-analyst-serve-serve.us-east.modal.run
# MODAL_KEY=wk-...
# MODAL_SECRET=ws-...

# Public app URL (used in Stripe success/cancel redirect URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3019

# Dev-only auth bypass: opens /dashboard without OAuth, serves a fake pro
# session. Hard-disabled when NODE_ENV=production, so it never leaks.
# DEV_BYPASS_AUTH=true

# Local-only: Prisma CLI reads this for `prisma migrate diff`.
# The D1 binding itself is configured in wrangler.jsonc, not here.
DATABASE_URL="file:./prisma/dev.db"
