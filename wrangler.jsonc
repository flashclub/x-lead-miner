{
  // Next.js on Cloudflare Workers via @opennextjs/cloudflare
  //
  // Database: all MonoBoard SaaS projects share ONE D1 database named "saas".
  // Each project starts with a baseline `<slug>_user` table and may use up to
  // two project-prefixed tables without additional approval, so every generated
  // app points at the same database_name and database_id.
  //
  // First-time setup (once for the whole monorepo):
  //   wrangler d1 create saas
  // Then paste the returned database_id below. New projects created afterwards
  // only need `pnpm db:migrate:local` (or :remote) to add their `<slug>_user`
  // table to this shared database — no new `d1 create` per project.
  "name": "x-lead-miner",
  // 自定义域名：wrangler 部署时自动注册路由并创建 DNS 记录
  "routes": [
    { "pattern": "x-lead-miner.ideaguard.dev", "custom_domain": true }
  ],
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // OpenNext 静态资源（/_next/static 等）由这个目录提供服务
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Workers AI — in-Worker embedding inference for live intent scoring
  // (bge-base-en-v1.5, 768-d — matches the trained head's input space)
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "saas",
      "database_id": "7ea9931b-bc52-40c7-b09e-588704a21bfa"
    }
  ],
  // Stripe webhook needs a raw body; the default size limit is fine.
  "observability": {
    "enabled": true
  }
}
