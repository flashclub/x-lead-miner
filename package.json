{
  "name": "x-lead-miner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3019",
    "dev:edge": "opennextjs-cloudflare preview",
    "build": "next build",
    "deploy": "opennextjs-cloudflare deploy",
    "start": "next start --port 3019",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate:local": "wrangler d1 execute saas --local --file=migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute saas --remote --file=migrations/0001_init.sql",
    "db:diff": "prisma migrate diff --from-empty --to-schema-datamodel ./prisma/schema.prisma --script --output migrations/0001_init.sql",
    "x:smoke": "tsx --env-file-if-exists=.dev.vars scripts/x-api-smoke.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.0.0",
    "@prisma/adapter-d1": "^6.0.0",
    "@prisma/client": "^6.0.0",
    "next": "^15.1.0",
    "next-auth": "5.0.0-beta.25",
    "next-intl": "^4.13.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^17.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.20.0",
    "eslint-config-next": "^15.1.0",
    "prisma": "^6.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "wrangler": "^3.90.0"
  },
  "monoboard": {
    "category": "saas",
    "stage": "building",
    "theme": "ember",
    "description": "X 线索挖掘工具：监听 X 上的购买意向帖（求推荐/比价/吐槽竞品），打分汇成线索队列（开发中）"
  }
}
